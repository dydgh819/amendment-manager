# 국가법령정보 공동활용 Open API 인증키 (open.law.go.kr 에서 발급)
#
# 배포 환경(운영)에서는 이 파일을 쓰지 않고 Secret Manager를 사용한다:
#   firebase functions:secrets:set LAW_OC
#
# 로컬 에뮬레이터에서 테스트할 때만 아래 값을 채운 뒤
# 이 파일을 복사해 functions/.secret.local 로 저장한다 (git에는 커밋되지 않음).
LAW_OC=your_law_go_kr_oc_key

# Gemini API 키 (STEP 6 실무 영향 요약용). https://aistudio.google.com 에서 무료 발급.
# 배포 환경에서는: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key
# 무료 티어 모델. 다른 무료 모델로 바꾸려면 이 값만 변경하면 된다 (기본값: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
