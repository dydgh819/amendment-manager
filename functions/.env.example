# 로컬에서 스크립트를 테스트할 때 사용하는 환경변수 예시.
# 이 파일을 복사해 functions/.env 로 저장하고 값을 채운다 (git에는 커밋되지 않음).
#
# 실제 운영(GitHub Actions)에서는 이 파일을 쓰지 않고 저장소의
# Settings → Secrets and variables → Actions 에 같은 이름으로 등록한다.

# 국가법령정보 공동활용 Open API 인증키. open.law.go.kr 가입 시 사용한
# 이메일의 아이디 부분이 OC 값이다 (예: hong123@gmail.com -> hong123).
LAW_OC=your_law_go_kr_oc_key

# Gemini API 키 (STEP 6 실무 영향 요약용). https://aistudio.google.com 에서 무료 발급.
GEMINI_API_KEY=your_gemini_api_key
# 무료 티어 모델. 다른 무료 모델로 바꾸려면 이 값만 변경하면 된다 (기본값: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Firestore 접근용 서비스 계정 키(JSON) 전체를 한 줄 문자열로. 로컬에서 이미
# `gcloud auth application-default login`으로 인증해 뒀다면 생략 가능.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}
