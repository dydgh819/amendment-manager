{
  "name": "functions",
  "description": "개정 예정 법령 검토 프로그램 - Cloud Functions (Open API 프록시)",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "detect": "node scripts/detectPendingAmendments.js",
    "detect:selftest": "node scripts/detectPendingAmendments.selftest.js",
    "detect-and-save": "node scripts/detectAndSave.js",
    "save:selftest": "node scripts/savePendingAmendments.selftest.js",
    "articles:selftest": "node scripts/getChangedArticles.selftest.js",
    "diffs:selftest": "node scripts/getArticleDiffs.selftest.js",
    "diffs-update:selftest": "node scripts/updateArticleDiffs.selftest.js",
    "summarize:selftest": "node scripts/summarizeArticleImpact.selftest.js",
    "summarize-update:selftest": "node scripts/updateSummaries.selftest.js",
    "pipeline:selftest": "node scripts/runPipeline.selftest.js",
    "selftest": "npm run detect:selftest && npm run save:selftest && npm run articles:selftest && npm run diffs:selftest && npm run diffs-update:selftest && npm run summarize:selftest && npm run summarize-update:selftest && npm run pipeline:selftest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0"
  },
  "private": true
}
